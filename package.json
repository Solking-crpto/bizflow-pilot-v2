{
  "name": "bizflow-pilot-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "prisma generate && next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan:bundle": "tsx scripts/scan-client-bundle.ts",
    "db:push": "prisma db push",
    "db:push:mainnet": "dotenv -e .env.mainnet.local -- prisma db push",
    "db:push:testnet": "dotenv -e .env.testnet.local -- prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:testnet": "dotenv -e .env.testnet.local -- tsx scripts/seedV2.ts",
    "preflight:mainnet": "dotenv -e .env.mainnet.local -- tsx scripts/preflight-mainnet.ts",
    "preflight:testnet": "dotenv -e .env.testnet.local -- tsx scripts/preflight-testnet.ts",
    "deploy:anchor:mainnet": "dotenv -e .env.mainnet.local -- tsx scripts/deployAnchorMainnet.ts",
    "deploy:anchor:testnet": "dotenv -e .env.testnet.local -- tsx scripts/deployAnchorTestnet.ts",
    "deploy:vault": "dotenv -e .env.testnet.local -- tsx scripts/deployPolicyVault.ts",
    "deploy:vault:mainnet": "dotenv -e .env.mainnet.local -- tsx scripts/deployPolicyVault.ts",
    "compile:contracts": "node scripts/compile-anchor.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^1.1.2",
    "@prisma/client": "^5.21.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "solc": "^0.8.37",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.21.35",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "hardhat": "^3.19.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
